# ==============================================================================
# Nginx Reverse Proxy Configuration - Vivo Report System
# File: /etc/nginx/sites-available/vivo-report.conf
# Symlink: ln -s /etc/nginx/sites-available/vivo-report.conf /etc/nginx/sites-enabled/
# Domain: vivo.pdarc.space
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HTTP (PORT 80)
# Hoạt động ngay lập tức không cần chứng chỉ SSL ban đầu.
# Cho phép ứng dụng hoạt động ngay và hỗ trợ cấp chứng chỉ Certbot Let's Encrypt.
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name vivo.pdarc.space;

    # Cho phép Certbot xác thực qua Webroot ACME Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Giới hạn kích thước file upload Excel
    client_max_body_size 50M;

    # Chuyển tiếp tới Next.js container chạy tại 127.0.0.1:3000
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Chống giả mạo IP: X-Real-IP lấy chính xác từ địa chỉ IP kết nối của client
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout xử lý file Excel lớn và đồng bộ n8n
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}

# ------------------------------------------------------------------------------
# 2. HƯỚNG DẪN BẬT HTTPS TỰ ĐỘNG BẰNG CERTBOT (1 LỆNH DUY NHẤT):
# Sau khi lưu file và kích hoạt cấu hình, chạy lệnh:
#   sudo certbot --nginx -d vivo.pdarc.space
#
# Certbot sẽ tự động cấp chứng chỉ miễn phí từ Let's Encrypt và cấu hình
# tự động redirect toàn bộ HTTP sang HTTPS an toàn.
# ------------------------------------------------------------------------------

